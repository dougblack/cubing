{
  "name": "@cubing/core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Speedcubing domain library: entity types, cube simulator, scramble + tracker, stats, phase detection, OLL/PLL recognition. Pure-logic; cubing.js dependency is isolated to scramble + alg parsing.",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./entities": "./src/entities.ts",
    "./cube": "./src/cube.ts",
    "./scramble": "./src/scramble.ts",
    "./scramble-tracker": "./src/scramble-tracker.ts",
    "./stats": "./src/stats.ts",
    "./phases": "./src/phases.ts",
    "./recognition": "./src/recognition.ts",
    "./orientation": "./src/orientation.ts"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "tsc --noEmit"
  },
  "dependencies": {
    "cubing": "^0.63.0"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "vitest": "^4.1.0"
  }
}
